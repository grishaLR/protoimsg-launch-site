---
const scenes = [
  {
    name: 'Home',
    tier: 'Inner circle',
    image: '/images/town-home.webp',
    alt: 'A lamplit pixel-art room with a bed, a green couch, a bookshelf, a red rug and a moonlit window; a character stands by the door marked “Your neighborhood”.',
    desc: 'Where you spawn: your own lamplit room. Nobody walks in uninvited. Your inner circle can knock, and you decide who comes in. Your window glows for them while you\'re home.',
  },
  {
    name: 'Neighborhood',
    tier: 'Community',
    image: '/images/town-neighborhood.webp',
    alt: 'A house with a plum roof and warmly lit windows; two characters stand on the path outside, linked by a soft purple aura.',
    desc: 'Out your front door, behind your own gate. People in your community can visit. Inside, everyone sees the owner and their mutuals, and nobody else.',
  },
  {
    name: 'Town square',
    tier: 'Everyone',
    image: '/images/town-square.webp',
    alt: 'A fence lined with gates labeled with friends’ names and sprites, above a stone plaza; three characters chat on the path, linked by a purple aura.',
    desc: 'Out past your gate: a plaza with a gate to every friend\'s neighborhood. Anyone can see you and walk up to talk, or switch on friends-of-friends mode to keep it to people two steps away.',
  },
] as const;
---

<section class="town" id="town" aria-labelledby="town-title">
  <div class="town-header">
    <p class="town-badge"><span aria-hidden="true">🚧</span> Beta · under construction</p>
    <h2 id="town-title">proto town: walk up and talk</h2>
    <p>
      A little pixel world where your ATProto identity is your character. Walk up to someone and
      you're in a conversation. No links to send, no meeting to schedule, no lobby to wait in.
    </p>
  </div>

  <figure class="town-shot">
    <img
      src="/images/town-square.webp"
      width="2000"
      height="1150"
      loading="lazy"
      decoding="async"
      alt="proto town's square: a fence lined with gates labeled with friends’ names and sprites, a path to a stone plaza, and three characters chatting, linked by a purple aura."
    />
    <figcaption>The town square: a gate for every friend's neighborhood, and a conversation in progress.</figcaption>
  </figure>

  <ul class="town-points">
    <li>
      <strong>Your character is you</strong>: your rpg.actor sprite, your handle, your buddy list.
      No new account and no avatar to build. Hold Space to sprint.
    </li>
    <li>
      <strong>Walk up, start talking</strong>: get close to someone and a purple aura links you. Voice
      connects on its own, and the closer you stand, the louder they are.
    </li>
    <li>
      <strong>Camera when you want it</strong>: your mic and camera stay off until you turn them on.
      Other people's video starts hidden until you choose to show it, and your camera switches off
      the moment someone new walks up.
    </li>
    <li>
      <strong>Knock, and they decide</strong>: your inner circle can knock on your door, and you
      choose “let in” or “not now”. Anything but “let in” just looks like no answer, so nobody can
      tell you said no. Ask a guest to leave any time, or close your door to knocks.
    </li>
    <li>
      <strong>Ask to join</strong>: in someone's neighborhood you only see your mutuals. Next to a
      conversation with people who aren't, you can ask to join. They all have to agree, and it lasts
      only while you stay.
    </li>
    <li>
      <strong>Blocks follow you</strong>: people you've blocked can't see you, hear you, end up in a
      conversation with you, or walk into your neighborhood, even while you're offline.
    </li>
  </ul>

  <h3 class="town-zones-title">Where you stand is who sees you</h3>
  <p class="town-zones-intro">
    Each place is its own space, laid out like your buddy list's trust tiers, so privacy is a place
    you walk to, not a setting you forget to flip. Your online status follows you too.
  </p>
  <div class="town-zones">
    {
      scenes.map((z) => (
        <div class="town-zone">
          <img
            class="town-zone-img"
            src={z.image}
            alt={z.alt}
            width="1600"
            height="1000"
            loading="lazy"
            decoding="async"
          />
          <span class="town-zone-name">{z.name}</span>
          <span class="town-zone-tier">{z.tier}</span>
          <span class="town-zone-desc">{z.desc}</span>
        </div>
      ))
    }
  </div>
</section>

<style>
  .town {
    padding: var(--space-3xl) 0;
    border-top: 1px solid var(--border);
  }

  .town-header h2 {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3.5vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-sm);
  }

  .town-header > p:last-child {
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .town-badge {
    display: inline-block;
    margin-bottom: var(--space-md);
    padding: var(--space-xs) var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--orange);
    border: 1px solid var(--orange);
    border-radius: 4px;
  }

  .town-shot {
    margin: var(--space-2xl) 0;
  }

  .town-shot img {
    display: block;
    width: 100%;
    height: auto;
    image-rendering: pixelated;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-raised);
  }

  .town-shot figcaption {
    margin-top: var(--space-sm);
    font-size: 0.85rem;
    color: var(--text-tertiary);
  }

  .town-points {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .town-points li {
    position: relative;
    padding-left: var(--space-xl);
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .town-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 8px;
    height: 1px;
    background: var(--purple);
  }

  .town-points li strong {
    color: var(--text);
    font-weight: 600;
  }

  .town-zones-title {
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-sm);
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
  }

  .town-zones-intro {
    margin-bottom: var(--space-lg);
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .town-zones {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .town-zone {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-md);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .town-zone-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    image-rendering: pixelated;
    border-radius: 4px;
    margin-bottom: var(--space-xs);
  }

  .town-zone-name {
    font-family: var(--font-display);
    font-weight: 600;
  }

  .town-zone-tier {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--purple);
  }

  .town-zone-desc {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  @media (max-width: 640px) {
    .town-zones {
      grid-template-columns: 1fr;
    }
  }
</style>
